# Copy to .env.staging on the Ubuntu staging host; keep the real file mode 600.
# Never put production credentials in this file.
GIT_SHA=replace-with-a-full-commit-sha
STAGING_BIND_ADDRESS=172.16.50.200
# 8088 is already used by another local service on the current Ubuntu host.
STAGING_PORT=18088
ACCOUNTS_DB_NAME=commander_staging
ACCOUNTS_DB_USER=commander
ACCOUNTS_DB_PASSWORD=replace-with-a-long-random-local-password
# Set true only for a LAN-restricted E2E session; turn it back off immediately afterwards.
GAME_DEV_ENDPOINTS_ENABLED=false
