                            "from": "hideawayRest",
                            "destination": {
                                "type": "ToZone",
                                "zone": "Library",
                                "placement": "Bottom"
                            },
                            "order": "Random"
                        }
                    ]
                }
            }
        ],
        "activatedAbilities": [
            {
                "id": "ability_2",
                "cost": "CostTap",
                "effect": {
                    "type": "AddMana",
