                },
                "timing": "ManaAbility",
                "isManaAbility": true
            },
            {
                "id": "ability_3",
                "cost": {
                    "type": "CostComposite",
                    "costs": [
                        {
                            "type": "CostAtomWrapper",
                            "atom": {
                                "type": "AtomMana",
                                "cost": "{G}"
                            }
                        },
                        "CostTap"
                    ]
                },
                "effect": {
                    "type": "Composite",
                    "effects": [
                        {
                            "type": "GatherCards",
                            "source": "FromLinkedExile",
                            "storeAs": "hideawayLinked"
                        },
                        {
                            "type": "GrantMayPlayFromExile",
                            "from": "hideawayLinked"
                        },
                        {
                            "type": "GrantPlayWithoutPayingCost",
                            "from": "hideawayLinked"
